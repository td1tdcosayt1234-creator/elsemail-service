# ---- Core ----
PORT=3001
# console | smtp | resend | sendgrid | brevo
# console = kothao pathabe na, sudhu terminal-e log korbe (testing er jonno)
# smtp = nijer ta (VPS / Gmail / cPanel) - kono third-party lagbe na
EMAIL_PROVIDER=console
EMAIL_FROM="My App <no-reply@yourdomain.com>"
FRONTEND_URL=http://localhost:3000
APP_NAME=My App

# ---- Service auth (optional but recommended) ----
# Eta set korle prottek /api/* request-e  x-api-key: <key>  header lagbe
SERVICE_API_KEY=change-me-strong-random-key

# ---- SMTP (nijer ta) - EMAIL_PROVIDER=smtp hole lage ----
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-smtp-password

# ---- Third-party API keys - je provider use korbe sudhu setai lage ----
# EMAIL_PROVIDER=resend hole:
RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_PROVIDER=sendgrid hole:
SENDGRID_API_KEY=SG.xxxxxxxxxxxx
# EMAIL_PROVIDER=brevo hole:
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx
